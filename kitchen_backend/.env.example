# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration (Railway-style PG variables)
PGHOST=localhost
PGPORT=5432
PGDATABASE=kitchen
PGUSER=kitchen
PGPASSWORD=kitchen

# JWT Configuration
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_64_char_base64_secret
JWT_EXPIRATION_MINUTES=60

# Frontend URL(s) for CORS — comma-separated
# Local dev: http://localhost:3000
# Production: https://hexhax.store,https://www.hexhax.store
APP_FRONTEND_URL=http://localhost:3000

# Cookie settings
# Set COOKIE_SECURE=true in production (HTTPS required)
COOKIE_SECURE=false
# Set COOKIE_DOMAIN=.hexhax.store in production for cross-subdomain auth
COOKIE_DOMAIN=

# Spoonacular API Configuration
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# OCR API Key
OCR_API_KEY=your_ocr_api_key_here
