# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=jdbc:postgresql://nozomi.proxy.rlwy.net:37610/railway?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters_long
JWT_EXPIRATION_MINUTES=60

# Frontend URL(s) for CORS — comma-separated, supports wildcard patterns like https://*.railway.app
APP_FRONTEND_URL=http://localhost:3000,https://*.railway.app

# Spoonacular API Configuration
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# OCR API Key
OCR_API_KEY=your_ocr_api_key_here